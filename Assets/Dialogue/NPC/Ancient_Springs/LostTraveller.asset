  m_Script: {fileID: 11500000, guid: ae4ce6e0954909147ab3c2dbfee869a6, type: 3}
  m_Name: LostTraveller
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScriptableObj
  entries:
  - text:
    - Aaaahhaaaaaaaaaa! Haahahhaaha!
    - I 'aven't seen a soul for... so long... long... time...
    condition: {fileID: 0}
    priority: 0
  - text:
    - It's this blasted wind! Ahahaha!
    - It ne'er stops. Day and night it blows, blast it!
    - Coming from that accursed kingdom it is!
    - Some foul work o' the Shadow, I take it.
    - You won't get much farther this way without any gear.
    - And down there is just a nasty tunnel network leading nowhere.
    - Ahaha! Who knows, maybe some unfortunate soul left some gear down there when
      they died!
    - Bahahahahahah!
    condition: {fileID: 11400000, guid: fa867954539b57e42bfb786b0a32d69d, type: 2}
    priority: 1
